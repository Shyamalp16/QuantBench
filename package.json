{
  "name": "quantbench",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm --filter @quantbench/desktop build",
    "format:check": "pnpm --filter @quantbench/desktop format:check",
    "lint": "pnpm --filter @quantbench/desktop lint",
    "test": "pnpm --filter @quantbench/desktop test",
    "typecheck": "pnpm --filter @quantbench/desktop typecheck"
  },
  "pnpm": {
    "overrides": {
      "qs": "6.16.0"
    }
  }
}
